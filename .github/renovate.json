{
  "extends": ["config:recommended"],
  "git-submodules": {"enabled": true, "managerFilePatterns": ["/.gitmodules/"]},
  "postUpdateOptions": ["npmDedupe"],
  "schedule": ["at any time"],
  "packageRules": [
    {
      "matchPackageNames": ["@cashu/cashu-ts"],
      "matchFileNames": ["package.json"],
      "groupName": "cashu-ts",
      "automerge": true
    }
  ],
  "timezone": "UTC"
}