{
  "extends": ["config:recommended"],
  "enabledManagers": ["git-submodules", "npm"],
  "git-submodules": {"enabled": true, "managerFilePatterns": ["/.gitmodules/"]},
  "postUpdateOptions": ["npmDedupe"],
  "schedule": ["at any time"],
  "packageRules": [
    {
      "matchPackageNames": ["@cashu/cashu-ts"],
      "matchFileNames": ["package.json"],
      "groupName": "cashu-ts",
      "postUpgradeTasks": {
          "commands": ["npm install --package-lock-only"],
          "fileFilters": ["package-lock.json"]
      },
      "automerge": true
    },
    {
      "matchDepTypes": ["git-submodules"],
      "automerge": true
    }
  ],
  "timezone": "UTC",
  "platformAutomerge": true
}