{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranchPatterns": ["main"],
  "automerge": true,
  "automergeType": "branch",
  "extends": ["config:recommended"],
  "enabledManagers": ["git-submodules"],
  "git-submodules": {"enabled": true, "managerFilePatterns": [".gitmodules"]},
  "schedule": ["at any time"],
  "packageRules": [
    {
      "matchDatasources": ["git-submodules"],
      "matchDepNames": ["cashu-ts"],
      "groupName": "cashu-ts-update",
      "automerge": true,
      "recreateWhen": "always",
      "automergeType": "branch"
    }
  ],
  "timezone": "UTC",
  "platformAutomerge": true
}